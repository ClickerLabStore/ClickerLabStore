{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clickerlabstore",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clickerlab-store",
      "database_id": "f9b1db32-77ce-4743-9478-63f0da6d486d"
    }
  ]
}
